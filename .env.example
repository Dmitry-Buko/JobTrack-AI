# --- Публичная конфигурация Supabase (безопасна для браузера) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- ВАЖНО: секреты сервера задаются НЕ здесь ---
# Gemini API-ключ хранится только в секретах Supabase Edge Functions:
#   supabase secrets set GEMINI_API_KEY=AIza...
# Модели и лимиты настраиваются переменными окружения функций:
#   GEMINI_TEXT_MODEL (по умолчанию gemini-3.8-flash)
#   GEMINI_LIVE_MODEL (по умолчанию gemini-3.8-live)
#   MAX_QUESTIONS (по умолчанию 10)
#   AI_RATE_LIMIT_PER_HOUR (по умолчанию 60)
