# --- Публичная конфигурация Supabase (безопасна для браузера) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- ВАЖНО: секреты сервера задаются НЕ здесь ---
# OpenAI API-ключ хранится только в секретах Supabase Edge Functions:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Модели и лимиты настраиваются переменными окружения функций:
#   OPENAI_TEXT_MODEL (по умолчанию gpt-4o-mini)
#   OPENAI_REALTIME_MODEL (по умолчанию gpt-4o-realtime-preview)
#   MAX_QUESTIONS (по умолчанию 10)
#   AI_RATE_LIMIT_PER_HOUR (по умолчанию 60)
